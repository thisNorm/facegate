# 복사해서 .env로 저장. .env는 저장소에 올리지 않는다.
# 첫 관리자: 관리자가 0명일 때만 사용. 실제 값은 이 파일에 쓰지 않는다.
INITIAL_ADMIN_ID=
INITIAL_ADMIN_PASSWORD=
# APP_ENV: 개발 PC만 development. 빈 값은 production.
APP_ENV=
# 아래 빈 값은 서버 기본값 사용.
# GATES_FILE: DB에 게이트가 없을 때 처음 한 번만 가져온다. 그 뒤 게이트와 단말은 관리자 웹 게이트 화면에서 관리 (D-57).
PORT=
DB_PATH=
FILE_DIR=
GATES_FILE=
DUPLICATE_WINDOW_SEC=
ADMIN_WEB_DIR=
# 단말 영상 확인용 FFmpeg 실행 파일. 빈 값은 PATH의 ffmpeg 사용.
FFMPEG_PATH=
# INGEST_KEY는 선택적인 최초 시드. 이후 관리자 설정에서 발급.
INGEST_KEY=
# 백업: 매일 04시 DB 사본(날짜별, BACKUP_KEEP_DAYS일 보관)과 등록 얼굴 사진 거울. 빈 값은 storage/backup, 14일.
BACKUP_DIR=
BACKUP_KEEP_DAYS=
# HTTPS: 두 파일을 모두 주면 관리자 웹을 HTTPS_PORT(빈 값은 8443)로 열고 HTTP 관리자 웹은 그쪽으로 넘긴다.
# 단말과 AI는 계속 PORT(HTTP)로 접속한다.
TLS_CERT_FILE=
TLS_KEY_FILE=
HTTPS_PORT=

# 핸드폰으로 열기 (D-62). 직원 핸드폰 브라우저가 여는 서버 주소. 비우면 이 기능을 끈다
# 핸드폰에서 경고 없이 열리려면 정식 인증서가 있는 회사 도메인 (docs/11 3장)
PHONE_BASE_URL=
